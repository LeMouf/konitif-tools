{
  "name": "@konitif/tools",
  "license": "PolyForm-Noncommercial-1.0.0",
  "version": "0.284.1",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "LICENSE.md",
    "dist",
    "src",
    "README.md",
    "package.json",
    "reference"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "prepack": "npm run build && npm test",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@konitif/core": "0.284.2"
  },
  "description": "Product-neutral tool contracts, capability declarations and implementation bindings for KONITIF.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeMouf/konitif-tools.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
