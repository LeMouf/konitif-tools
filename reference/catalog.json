{
  "schemaVersion": "1.0.0",
  "package": "@konitif/tools",
  "intent": "Declare, bind, and resolve tool capabilities independently of their surface.",
  "clusters": [
    {
      "id": "module-contract",
      "title": "Module contract",
      "summary": "Portable definition of a tool and its contributions.",
      "authority": "Canonical capability declaration.",
      "owns": [
        "module",
        "scope",
        "contributions"
      ],
      "doesNotOwn": [
        "UI component"
      ],
      "workflow": [
        "Define",
        "Qualify",
        "Publish"
      ],
      "symbolNames": [
        "defineKonitifToolModule",
        "DefineKonitifToolModuleInput",
        "KonitifToolModule",
        "KonitifToolScope",
        "KonitifToolContribution",
        "KonitifToolContributionKind"
      ]
    },
    {
      "id": "implementation-binding",
      "title": "Implementation binding",
      "summary": "Associates a portable definition with an implementation.",
      "authority": "Declared binding.",
      "owns": [
        "binding"
      ],
      "doesNotOwn": [
        "definition",
        "hosting"
      ],
      "workflow": [
        "Resolve",
        "Bind",
        "Verify"
      ],
      "symbolNames": [
        "bindKonitifToolModule",
        "KonitifToolImplementationBinding"
      ]
    },
    {
      "id": "registry",
      "title": "Registry",
      "summary": "Registers and resolves available modules.",
      "authority": "Admission catalog.",
      "owns": [
        "registration",
        "resolution"
      ],
      "doesNotOwn": [
        "UI lifecycle"
      ],
      "workflow": [
        "Register",
        "Resolve",
        "Provide"
      ],
      "symbolNames": [
        "KonitifToolModuleRegistry"
      ]
    }
  ]
}
